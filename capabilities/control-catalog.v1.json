{
  "schema": "mcf-dual-browser-control-catalog/v1",
  "application": "MCF Dual Browser Cockpit",
  "baselineVersion": "0.7.5",
  "ownerRepository": "https://github.com/leon337/mcf-dual-browser-cockpit",
  "contract": {
    "discovery": "GET /v1/control-catalog (authenticated, read-only)",
    "native": "window.cockpit.discovery.getCatalog() (trusted renderer only)",
    "localCli": "node bin/mcf-cockpit-discover.mjs --instance=notebook",
    "noGenericExecute": true,
    "noTokenInPayload": true,
    "twoPanedOnly": true,
    "bridgeRequiresLocalDescriptor": true
  },
  "limitations": [
    "Buttons in cockpit shell do not have a generic bridge invoke route; IPC can only originate in trusted renderer.",
    "HTTP POST is gated by PAUSE and individual endpoint policy; a route does not imply operational authorization.",
    "Agent identity UNBOUND is not READY; browser delivery does not prove canonical agent signature.",
    "Copying token to clipboard requires the native UI and can expose a secret to other local applications.",
    "External navigation, capture and settings are side-effectful; tests use isolated profiles.",
    "This baseline is 0.7.5 dual-pane, not TRI-agent 0.8.0."
  ],
