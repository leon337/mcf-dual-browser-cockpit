{
  "name": "mcf-dual-browser-cockpit",
  "version": "0.3.5",
  "description": "Cockpit desktop com ChatGPT e navegador operacional isolados, pronto para integração com MCF/agents.",
  "type": "module",
  "main": "src/main/main.mjs",
  "author": "LEANDRO / MCF",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage",
    "check": "node --check src/main/main.mjs && node --check src/main/bridge.mjs && node --check src/renderer/renderer.js && node --check src/preload/preload.cjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "br.com.mcf.dualbrowsercockpit",
    "productName": "MCF Dual Browser Cockpit",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
